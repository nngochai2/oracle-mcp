# =============================================================
# Oracle MCP Server — Environment Configuration
# =============================================================

# -------------------- Oracle Connection ----------------------
ORACLE_HOST=localhost
ORACLE_PORT=1521

# Use SERVICE_NAME (preferred for RAC / pluggable DBs)
ORACLE_SERVICE=INVOICING

# Use SID only if SERVICE_NAME is unavailable
# ORACLE_SID=XE

# Read-only MCP user — see setup script in db_setup.sql
ORACLE_USER=mcp_reader
ORACLE_PASSWORD=change_me

# ------------ Thick Mode (required for Oracle 11g) ------------
# Path to Oracle Instant Client directory.
# Leave blank to auto-discover from PATH / LD_LIBRARY_PATH.
#
# Linux example:  /usr/lib/oracle/21/client64/lib
# Windows example: C:\oracle\instantclient_21_13
ORACLE_CLIENT_LIB_DIR=

# ------------------- Schema Configuration ---------------------
# Schema to use when no schema argument is supplied to a tool.
# Defaults to ORACLE_USER if left blank.
ORACLE_DEFAULT_SCHEMA=INVOICING

# Comma-separated schema allowlist.  Limits all tool results
# to these schemas regardless of query arguments.
# Leave blank to expose all schemas visible to ORACLE_USER.
ALLOWED_SCHEMAS=INVOICING,INVOICING_REF

# ---------------------- Query Safety --------------------------
# Hard ceiling on rows returned by execute_query.
# Callers can request fewer, never more.
MAX_ROWS=200

# ------------------------ Logging -----------------------------
LOG_LEVEL=INFO
